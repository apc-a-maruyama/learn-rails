FROM ruby:3.4-slim

# RUN apt-get update -qq && \
#   apt-get install --no-install-recommends -y \
#   build-essential \
#   libsqlite3-dev \
#   pkg-conig
RUN apt-get update -qq && \
  apt-get install --no-install-recommends -y build-essential libsqlite3-dev pkg-config

WORKDIR /rails

COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY . .

CMD ["bin/rails", "erver", "-b", "0.0.0.0"]
